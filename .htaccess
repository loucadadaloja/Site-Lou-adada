# Louçadada — configuração para hospedagem Apache (cPanel, Hostgator, Locaweb e afins).
# Em Vercel, Netlify ou GitHub Pages este arquivo é ignorado, e tudo bem:
# lá as URLs limpas e o cache já vêm resolvidos por padrão.

# --- HTTPS e domínio único ---------------------------------------------------
# Um site, um endereço. Sem isto o site responde em quatro endereços
# diferentes (com e sem www, com e sem https) e o Google trata cada um como
# um site separado, dividindo a força de todos eles.
#
# Descomente o bloco depois que o cadeado estiver aparecendo no navegador.
# Ele resolve as duas coisas num salto só: joga tudo para
# https://loucadada.com, sem www.
#
# Se o painel da hospedagem já tiver um botão de "Forçar HTTPS" ligado,
# use só um dos dois. Os dois juntos fazem o navegador pular duas vezes
# antes de abrir a página, e isso aparece na conta do visitante.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} ^www\. [NC]
#   RewriteRule ^(.*)$ https://loucadada.com/$1 [L,R=301]
# </IfModule>

# --- página de erro ----------------------------------------------------------
ErrorDocument 404 /404.html

# --- tipos de arquivo --------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                     .webp
  AddType image/svg+xml                  .svg
  AddType font/woff2                     .woff2
  AddType application/manifest+json      .webmanifest
</IfModule>

# --- compressão --------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # woff2 e webp já vêm comprimidos: comprimir de novo só gasta CPU.
</IfModule>

# --- cache -------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # o HTML precisa ser sempre fresco, senão a troca de telefone demora a aparecer
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # as fontes ficam no mesmo domínio, mas isso evita dor de cabeça com CDN
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- barra no fim da URL -----------------------------------------------------
# /a-casa e /a-casa/ devem levar ao mesmo lugar, sem duplicar conteúdo no Google.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --- protege o que não é do site ---------------------------------------------
# Arquivo de desenvolvimento não é conteúdo: some da web e do Google.
<FilesMatch "^\.(git|htaccess|gitignore)">
  Require all denied
</FilesMatch>

<FilesMatch "\.(md|json|lock|psd|ai|yml|yaml)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # a pasta de documentação e a do GitHub respondem 404, não 403:
  # 403 vira "bloqueado por robots" no Search Console e fica incomodando
  RewriteRule ^(docs|\.github)(/|$) - [R=404,L]
</IfModule>

# --- redirecionamentos --------------------------------------------------------
# Regra de ouro do playbook: URL nunca morre, ela redireciona.
# Quando alguma URL mudar, o 301 entra aqui, nesta ordem:
#   Redirect 301 /url-antiga/ https://loucadada.com/url-nova/
